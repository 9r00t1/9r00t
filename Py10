selenium_login.py:

from selenium import webdriver selenium.webdriver.common.by import By import time

# 1. Open Chrome Browser

driver = webdriver.Chrome()

# 2. Open Localhost Website

driver.get("http://localhost:8000")

time.sleep(2)

#3. Find input fields and type credentials

driver.find_element(By.ID, "username").send_keys("student123")

driver.find_element(By.ID, "password").send_keys("pass123")

#4. Click Login Button

driver.find_element(By.ID, "login-button").click()

#5. Wait to view result and close browser

time.sleep(5)

driver.quit()
